rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Perfil de quien hace la petición. Si no existe, la regla falla y se niega el acceso.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return signedIn() && me().role == 'superadmin';
    }

    function isApprovedAdmin() {
      return signedIn() && me().role == 'admin' && me().status == 'approved';
    }

    // Perfiles de usuario
    match /users/{uid} {
      // Cada persona lee su propio perfil; el super admin lee todos.
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());

      // Solicitud de acceso: solo se puede crear el propio perfil como
      // administrador "pendiente". Nadie puede auto-asignarse super admin ni aprobarse.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'role', 'status', 'createdAt'])
        && request.resource.data.role == 'admin'
        && request.resource.data.status == 'pending'
        && request.resource.data.email.lower() == request.auth.token.email.lower();

      // Solo el super admin aprueba, rechaza o elimina, y no puede cambiar roles.
      allow update: if isSuperAdmin()
        && request.resource.data.role == resource.data.role;
      allow delete: if isSuperAdmin();
    }

    // Campeonatos: lectura pública (visitantes), escritura solo del dueño aprobado.
    match /tournaments/{tid} {
      allow read: if true;

      allow create: if isApprovedAdmin()
        && request.resource.data.ownerId == request.auth.uid;

      // El dueño no puede cambiar a quién pertenece el campeonato.
      allow update: if (isApprovedAdmin()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId)
        || isSuperAdmin();

      allow delete: if (isApprovedAdmin() && resource.data.ownerId == request.auth.uid)
        || isSuperAdmin();

      // Grupos, equipos, jugadores, partidos... (todo lo que cuelga de un campeonato)
      match /{sub=**} {
        allow read: if true;
        allow write: if (isApprovedAdmin()
          && get(/databases/$(database)/documents/tournaments/$(tid)).data.ownerId == request.auth.uid)
          || isSuperAdmin();
      }
    }
  }
}
